        o."Object Text" = "TC-0002 视频并发验证：系统应提供视频并发验证，缺陷回归通过率100%。【类型:测试用例｜优先级:低｜验证:测试｜状态:草稿｜责任人:赵磊｜来源:内部评审】"
        o = create(m_TC)
        o."Object Text" = "TC-0001 报表功能验证：系统应具备报表功能验证能力，缺陷回归通过率100%。【类型:测试用例｜优先级:高｜验证:演示｜状态:待评审｜责任人:王强｜来源:现场反馈】"
        h = create(m_TC)
        h."Object Heading" = "1.1 测试范围"
        h = create(m_TC)
        h."Object Heading" = "1 测试策略"
        save m_TC
        log << "TC: created (93 reqs, 24 headings)\n"
    }
} else {
    log << "TC: already exists, skipped\n"
}

log << "import done\n"
close(log)
