Object nthReq(Module m, int k) {
    Object o
    Object found = null
    string hd
    int n = 0
    for o in m do {
        hd = o."Object Heading"
        if (hd == "") {
            n++
            if (n == k) { found = o }
        }
    }
    return found
}

