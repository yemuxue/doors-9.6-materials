Stream s = write("C:/doors-demo/doors-enterprise/output/all-objects.txt")
Module m
Object o
string num
string hd
string txt
// SYS
m = read("/01 系统需求/SYS_系统需求规格", true)
if (null m) {
    s << "ERR|SYS|open-failed\n"
} else {
    for o in m do {
        num = number o
        hd = o."Object Heading"
        txt = o."Object Text"
        s << "SYS|"
        s << num
        s << "|"
        s << hd
        s << "|"
        s << txt
        s << "\n"
    }
}
