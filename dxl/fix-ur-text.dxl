int n = 0
Object nthReq(Module m, int k) {
    Object x
    Object found = null
    string hd
    int c = 0
    for x in m do {
        hd = x."Object Heading"
        if (hd == "") { c++ ; if (c == k) { found = x } }
    }
    return found
}
